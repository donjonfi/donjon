{
  "name": "donjon",
  "version": "3.12.1",
  "description": "Donjon FI",
  "author": {
    "name": "Jonathan Claes",
    "url": "https://github.com/donjonfi/donjon"
  },
  "scripts": {
    "ng": "ng",
    "ensure-standalone": "node ensure-standalone.js",
    "prestart": "node ensure-standalone.js",
    "start": "ng serve donjon-creer --configuration development",
    "start:compagnon": "ng serve donjon-compagnon --configuration development",
    "prebuild": "node ensure-standalone.js",
    "build": "ng build",
    "build:compagnon": "ng build donjon-compagnon --configuration bundle && node ../../scripts/sync-compagnon.js",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "test:prod": "ng test donjon --watch=false --coverage",
    "e2e": "npm run e2e:build && playwright test",
    "e2e:build": "node ensure-standalone.js && ng build donjon-jouer --configuration development && ng build donjon-creer --configuration development"
  },
  "private": true,
  "dependencies": {
    "@angular/animations": "^22.2.3",
    "@angular/common": "^22.2.3",
    "@angular/compiler": "^22.2.3",
    "@angular/core": "^22.2.3",
    "@angular/forms": "^22.2.3",
    "@angular/platform-browser": "^22.2.3",
    "@angular/platform-browser-dynamic": "^22.2.3",
    "@angular/router": "^22.2.3",
    "@fortawesome/fontawesome-free": "^6.7.2",
    "bootstrap": "^5.3.8",
    "file-saver-es": "^2.0.5",
    "ngx-ace-wrapper": "^17.0.0",
    "ngx-bootstrap": "^22.0.0",
    "rand-seed": "^1.0.1",
    "rxjs": "~7.8.1",
    "tslib": "^2.4.0",
    "uuid": "^14.0.3",
    "zone.js": "^0.16.3"
  },
  "devDependencies": {
    "@angular/build": "^22.2.4",
    "@angular/cli": "^22.2.4",
    "@angular/compiler-cli": "^22.2.3",
    "@playwright/test": "^1.64.1",
    "@types/file-saver": "^2.0.5",
    "@types/node": "^22.0.0",
    "@types/uuid": "^11.0.0",
    "@vitest/coverage-v8": "^5.0.5",
    "jsdom": "^30.1.3",
    "ng-packagr": "^22.2.5",
    "typescript": "~6.0.3",
    "vitest": "^5.0.5"
  },
  "overrides": {
    "undici": "^7.30.1",
    "vite": "^8.3.5"
  }
}
