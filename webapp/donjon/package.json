{
  "name": "donjon",
  "version": "3.12.1",
  "description": "Donjon FI",
  "author": {
    "name": "Jonathan Claes",
    "url": "https://github.com/donjonfi/donjon"
  },
  "scripts": {
    "ng": "ng",
    "ensure-standalone": "node ensure-standalone.js",
    "prestart": "node ensure-standalone.js",
    "start": "ng serve donjon-creer --configuration development",
    "start:compagnon": "ng serve donjon-compagnon --configuration development",
    "prebuild": "node ensure-standalone.js",
    "build": "ng build",
    "build:compagnon": "ng build donjon-compagnon --configuration bundle && node ../../scripts/sync-compagnon.js",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "test:prod": "ng test donjon --watch=false --coverage"
  },
  "private": true,
  "dependencies": {
    "@angular/animations": "^21.2.25",
    "@angular/common": "^21.2.25",
    "@angular/compiler": "^21.2.25",
    "@angular/core": "^21.2.25",
    "@angular/forms": "^21.2.25",
    "@angular/platform-browser": "^21.2.25",
    "@angular/platform-browser-dynamic": "^21.2.25",
    "@angular/router": "^21.2.25",
    "@fortawesome/fontawesome-free": "^6.7.2",
    "bootstrap": "^5.3.8",
    "file-saver-es": "^2.0.5",
    "ngx-ace-wrapper": "^17.0.0",
    "ngx-bootstrap": "^21.2.2",
    "rand-seed": "^1.0.1",
    "rxjs": "~7.8.1",
    "tslib": "^2.4.0",
    "uuid": "^14.0.3",
    "zone.js": "~0.15.0"
  },
  "devDependencies": {
    "@angular/build": "^21.2.28",
    "@angular/cli": "^21.2.28",
    "@angular/compiler-cli": "^21.2.25",
    "@types/file-saver": "^2.0.5",
    "@types/node": "^22.0.0",
    "@types/uuid": "^8.3.4",
    "@vitest/coverage-v8": "^4.1.12",
    "jsdom": "^30.1.3",
    "ng-packagr": "^21.2.7",
    "typescript": "~5.9.3",
    "vitest": "^4.1.12"
  },
  "overrides": {
    "undici": "^7.30.1"
  }
}
