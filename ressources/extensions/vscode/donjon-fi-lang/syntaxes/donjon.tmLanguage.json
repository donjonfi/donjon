{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Donjon",
  "patterns": [
    {
      "include": "#strings"
    },
    {
      "include": "#comments"
    },
    {
      "include": "#inclure-statement"
    },
    {
      "include": "#keywords"
    },
    {
      "include": "#temporal"
    },
    {
      "include": "#support"
    },
    {
      "include": "#storage"
    },
    {
      "include": "#variables"
    },
    {
      "include": "#bracket-tag"
    },
    {
      "include": "#format-braces"
    },
    {
      "include": "#wait-key"
    }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.line",
          "match": "--(.*)$"
        }
      ]
    },
    "inclure-statement": {
      "patterns": [
        {
          "match": "^(\\s*)(inclure)\\s+([\"“])([^\"”]+)([\"”])\\s*\\.?\\s*$",
          "captures": {
            "2": {
              "name": "keyword.control.import.donjon"
            },
            "3": {
              "name": "punctuation.definition.string.begin.donjon"
            },
            "4": {
              "name": "string.quoted.double.donjon"
            },
            "5": {
              "name": "punctuation.definition.string.end.donjon"
            }
          }
        }
      ]
    },
    "support": {
      "patterns": [
        {
          "name": "support.function",
          "match": "\\b(afficher|ajouter|allumer|annuler|arrêter|attendre|augmenter|changer|charger|commencer|consommer|continuer|copier|créer|creer|décharger|déplacer|déterminer|déverrouiller|dire|diminuer|donner|effacer|enlever|éteindre|exécuter(?! (\\w)+(er|re|ir))|fermer|interrompre|jouer|lister|mémoriser|oublier|ouvrir|prendre|refuser|remplacer|retirer|sauver|sélectionner|stopper|terminer|tester|verrouiller|vider)\\b(?!\\.)"
        },
        {
          "name": "keyword.other.direction.donjon",
          "match": "(au (sud|nord)(?:-(?:est|ouest))?)|(au(\\-| )(dessus|dessous))|(en (haut|bas|dessous|dessus))|(à l('|’)(ouest|est|intérieur|extérieur))|sur |dans |sous"
        },
        {
          "name": "support.type.property.donjon",
          "match": "\\b((i|I)ntitulé|(p|P)ronom|description|quantité|infinitif|préposition|titre|auteur(s)?|aperçu|texte|lien|capacité|accord|réaction|version|site|web|aide|commande|action|contenu|musique|image|thème|sortie(s)?)\\b"
        },
        {
          "name": "constant.language",
          "match": "(\\b(présent|absent|intact|déplacé|modifié|mentionné|vu|famili(er|èr)|couvert|décorati(f|v)|secr(et|èt)|caché|discr(et|èt)|(in)?dénombrable|mangeable|buvable|ouvrable|ouvert|fermé|verrouillable|(dé)?verrouillé|clair|obscur|allumé|éteint|marche|arrêt|arrêté|parlant|opaque|transparent|fixé|(trans)?portable|solide|liquide|gazeu(x|s)|(im)?perméable|enfilable|équipable|chaussable|porté|enfilé|équipé|chaussé|possédé|disponible|occupé|(in)?visible|(in)?accessible|adjacent|initialisé|affiché|multiple|unique|illimité|cassé|actionné|connu|visité)(e)?(s)?(?!\\w))"
        }
      ]
    },
    "storage": {
      "patterns": [
        {
          "name": "storage.type",
          "match": "(une \\b(clé|porte|personne|action|direction|liste|listevide|listenombre|listetexte|listeintitulé|listemixte|ressource)\\b)|(un \\b(obstacle|lieu|objet|animal|décor|contenant|support|vivant|compteur|concept|intitulé|élément)\\b)|des \\b(clés|portes|obstacles|personnes|lieux|objets|animaux|décors|contenants|supports|listes|compteurs|directions|vivants|concepts|intitulés|éléments|ressources)\\b|(deux \\b(objets)\\b)"
        }
      ]
    },
    "variables": {
      "patterns": [
        {
          "name": "variable.language",
          "match": "\\b((C|c)eci|(C|c)ela|cela|ici|celui-ci|celle-ci|ceux-ci|celles-ci|quantitéCeci|quantitéCela|prépositionCeci|prépositionCela|réponse|origine|destination|orientation|(le )?nombre de)\\b"
        },
        {
          "name": "variable.parameter",
          "match": "\\b(joueur|inventaire|jeu|licence)\\b"
        }
      ]
    },
    "keywords": {
      "patterns": [
        {
          "name": "keyword.control.donjon",
          "match": "((?i)\\b(désactiver|activer|si|sinon|sinonsi|(autre )?choix|choisir( parmi)?|quand|interpréter|comme|au hasard|en boucle|1ère fois|1ere fois|1re fois|[1-9][0-9]?(e|ème|eme)? fois|initialement|prioritairement|progressivement|puis|fin (action|réaction(s)?|règle|routine|si|choix|choisir)|fin|finsi|finchoisir|finchoix|mais (pas|bien|ni|soit|plus)|ainsi que|et( que)?|ou( que)?|ni|soit|partie|PARTIE|chapitre|CHAPITRE|scène|SCÈNE|forment une bascule|se contredisent|implique|exclut|est un état|non|principa(l|le|ux|les)|secondaires?|suppl(é|e)mentaires?|courantes?|compl(é|e)mentaires?|probables?|possibles?|masqu(é|e)es?|prépositions|aucune?)\\b)|(\\baction\\b(?!;|\\.))|((?i)^(\\s)*(red(é|e)finir\\s+(l['’]\\s*)?action|réaction(s)?|action|règle (avant|après|remplacer)|routine|concernant) (?=.+:))|((?i)^\\s*(phase (prérequis|exécution|épilogue)|définition(s)?|basique)\\s*:)|((?i)\\b(il y a|exprimée?s? en)\\b)|((?i)avec l['’]unité)"
        },
        {
          "name": "keyword.operator",
          "match": "\\b((ne |n’|n')?(se |s’|s')?(?!l(’|'))(est|sont|trouve(nt)?|déclenche(nt)?|vau(len)?t|commence|diminue(nt)?|augmente(nt)?|attei(gne)?nt|dépasse(nt)?|contien(nen)?t|inclu(en)?t|existe|possède(nt)?|porte(nt)?(?! (de|d'|d’|comme)\\b)|réagi(ssen)?t|peu(ven)?t))( pas| plus)?( par)?\\b"
        }
      ]
    },
    "temporal": {
      "patterns": [
        {
          "name": "support.constant.time.donjon",
          "match": "\\b(dans|après) \\d+ (secondes?|tours?)\\b"
        }
      ]
    },
    "bracket-tag": {
      "name": "meta.bracket-tag.donjon",
      "begin": "(\\[)\\s*",
      "beginCaptures": {
        "1": {
          "name": "punctuation.section.bracket.begin.donjon"
        }
      },
      "end": "\\]",
      "endCaptures": {
        "0": {
          "name": "punctuation.section.bracket.end.donjon"
        }
      },
      "patterns": [
        {
          "match": "\\G([pcsv])(?=\\s)",
          "captures": {
            "1": {
              "name": "support.constant.bracket-prefix.donjon"
            }
          }
        },
        {
          "name": "variable.other.reference.donjon",
          "match": "[@#&][^\\s\\]]+"
        },
        {
          "name": "support.function.bracket-tag.donjon",
          "match": "\\b(intitulé|description|aperçu|statut|sorties|titre|obstacle vers|décrire objets (dans|sur)|lister objets inventaire)\\b"
        },
        {
          "include": "#keywords"
        },
        {
          "include": "#support"
        },
        {
          "include": "#variables"
        }
      ]
    },
    "format-braces": {
      "patterns": [
        {
          "name": "constant.character.escape.donjon",
          "match": "\\{[nNpeixU]\\}"
        },
        {
          "name": "markup.bold.donjon",
          "match": "\\{\\*[^*}]*\\*\\}"
        },
        {
          "name": "markup.italic.donjon",
          "match": "\\{/[^/}]*/\\}"
        },
        {
          "name": "markup.underline.donjon",
          "match": "\\{_[^_}]*_\\}"
        },
        {
          "name": "markup.inserted.donjon",
          "match": "\\{\\+[^+}]*\\+\\}"
        },
        {
          "name": "markup.deleted.donjon",
          "match": "\\{-[^\\-}]*-\\}"
        },
        {
          "name": "markup.heading.donjon",
          "match": "\\{=[^=}]*=\\}"
        }
      ]
    },
    "wait-key": {
      "patterns": [
        {
          "name": "support.function.macro.donjon",
          "match": "@@[^@]+@@"
        }
      ]
    },
    "strings": {
      "name": "string.interpolated.donjon",
      "begin": "\"|\\]",
      "end": "\\[|\"",
      "patterns": [
        {
          "include": "#format-braces"
        },
        {
          "include": "#wait-key"
        },
        {
          "name": "constant.character.escape.donjon",
          "match": "\\{.\\}|\\{.|.\\}"
        }
      ]
    }
  },
  "scopeName": "source.djn"
}
